GW_ROUTES_FILE=config/routes.yaml
GW_PRICES_FILE=config/prices.yaml
GW_PROVIDERS_FILE=config/providers.yaml
GW_REDIS_URL=redis://redis:6379/0
GW_CACHE_BACKEND=memory   # memory | redis (shared, survives restarts; uses GW_REDIS_URL) | off
GW_EMBEDDER=e5-small      # e5-small (ONNX, M4b) | hash (offline stand-in) | off
GW_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Free tiers ($0, synthetic data only). Without them every chain falls back to Ollama/mock.
# GW_GROQ_API_KEY=
# GW_GOOGLE_API_KEY=
# Paid providers stay disabled until P3's final test:
GW_RUN_BUDGET_USD=0
# GW_ANTHROPIC_API_KEY=
# dev | test | prod. The mock provider only exists in dev and test.
GW_ENV=dev
# SHA-256 of the admin key for /stats, /metrics and /admin/*.
# GW_ADMIN_KEY_SHA256=
# Traces are exported only when this is set (Jaeger in the obs profile).
# GW_OTEL_ENDPOINT=http://jaeger:4317
# true requires Presidio, or the gateway refuses to start.
GW_LOG_PROMPTS=false
# off | monitor (flag + count injection/PII heuristics) | enforce (also block injection with 400)
GW_GUARDRAILS_MODE=monitor
# Langfuse export over OTLP/HTTP (needs `uv sync --extra otel`; the legacy ingestion API is deprecated).
# All three required. Spans carry gen_ai.* attributes, never prompt text. Verified against a self-hosted Langfuse 4.75 (spans, model, token usage).
# GW_LANGFUSE_HOST=https://cloud.langfuse.com
# GW_LANGFUSE_PUBLIC_KEY=
# GW_LANGFUSE_SECRET_KEY=
# Prompt Guard 2 ONNX classifier: put the model in models/prompt-guard/ (see README); threshold 0..1
# GW_PROMPT_GUARD_THRESHOLD=0.5
# >0 reloads routes/clients/prices when their files change (POST /admin/reload always works)
# GW_RELOAD_INTERVAL_S=2
# SSE keep-alive comment after this many seconds of provider silence (0 = off)
GW_STREAM_PING_S=10

# --- observability and security (M8) ---
# SHA-256 of the admin key (python scripts/new_key.py --admin). Guards /stats, /metrics, /admin/*.
# Unset: open in dev/test, closed (403) in prod.
# GW_ADMIN_KEY_SHA256=
# One JSON line per request on stdout, never prompts. GW_LOG_PROMPTS=true needs Presidio (uv sync --extra pii).
GW_ACCESS_LOG=true
# GW_LOG_PROMPTS=false
# OTLP/HTTP endpoint for traces (uv sync --extra otel); the obs compose profile runs Jaeger on :4318.
# GW_OTEL_ENDPOINT=http://localhost:4318
# memory | redis (shared count, falls back to memory when Redis is down)
# GW_RATE_LIMIT_BACKEND=memory
# GW_MAX_BODY_BYTES=8000000
