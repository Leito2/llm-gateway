GW_ROUTES_FILE=config/routes.yaml
GW_PRICES_FILE=config/prices.yaml
GW_PROVIDERS_FILE=config/providers.yaml
GW_REDIS_URL=redis://redis:6379/0
GW_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Free tiers ($0, synthetic data only). Without them every chain falls back to Ollama/mock.
# GW_GROQ_API_KEY=
# GW_GOOGLE_API_KEY=
# Paid providers stay disabled until P3's final test:
GW_RUN_BUDGET_USD=0
# GW_ANTHROPIC_API_KEY=
# dev | test | prod. The mock provider only exists in dev and test.
GW_ENV=dev
# SHA-256 of the admin key for /stats, /metrics and /admin/*.
# GW_ADMIN_KEY_SHA256=
# Traces are exported only when this is set (Jaeger in the obs profile).
# GW_OTEL_ENDPOINT=http://jaeger:4317
# true requires Presidio, or the gateway refuses to start.
GW_LOG_PROMPTS=false
GW_GUARDRAILS_MODE=monitor
